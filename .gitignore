# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp

# node (на случай будущих инструментов сборки)
node_modules/
package-lock.json

# черновики/промежуточные файлы сборки демо (не для репозитория)
*-scene.js
*-head.html
*.mjs
# ИСПРАВЛЕНО (заход 56, реальный найденный баг — не гипотетический):
# правило *.mjs выше молча блокировало ВСЕ файлы тестов (tests/*.test.mjs)
# при git add — они просто никогда не попадали в коммит, хотя сообщение
# коммита утверждало обратное. Явное исключение — тесты остаются под
# версионным контролем, черновики где угодно ещё по-прежнему игнорируются.
!tests/**/*.mjs
